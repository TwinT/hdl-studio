{
    // Type checking only (`tsc`, part of `npm run lint`); webpack transpiles
    // with esbuild-loader.
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "types": []
    },
    "include": ["view/**/*.ts"]
}
