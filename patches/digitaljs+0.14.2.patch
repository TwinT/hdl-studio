new file mode 100644
index 0000000..34891a3
--- /dev/null
+++ b/node_modules/digitaljs/src/cells/tribuf.mjs
@@ -0,0 +1,78 @@
+"use strict";
+
+import * as joint from '@joint/core';
+import { portGroupAttrs, GateView } from './base.mjs';
+import { GateSVG, buf_path } from './gates.mjs';
+import { Vector4vl } from '@twint/4vl';
+
+// Classic tri-state buffer symbol: the same buffer triangle as Repeater/Not,
+// with EN entering from below into the triangle's vertical center. The box
+// is taller than the triangle (TRIBUF_HEIGHT vs. the triangle's natural
+// ~32px) so EN gets a lead-wire below the shape without its port dot
+// overhanging past the model's own `size` - unlike Mux's top `sel` port,
+// that keeps ELK's layout footprint accurate with no
+// getLayoutSize/setLayoutPosition offset dance needed.
+const TRIBUF_HEIGHT = 52;
+const TRIBUF_CENTER_Y = 16; // buf_path's fixed vertical center
+const TRIBUF_CENTER_X = 35; // buf_path's bounding-box horizontal center (x: 18..52)
+
+// Converted from yosys's $tribuf ("assign Y = EN ? A : 'bz;", per simlib.v):
+// EN high drives A through, EN low outputs high-Z, and EN unknown (x/z)
+// follows Verilog's 4-valued ternary rule for an unknown condition - since
+// the false branch is a constant z on every bit, that reduces to "keep z
+// where A is already z, x everywhere else".
+export const Tribuf = GateSVG.define('Tribuf', {
+    /* default properties */
+    bits: 1,
+    propagation: 0,
+
+    size: { width: 60, height: TRIBUF_HEIGHT },
+    attrs: { gate: { d: buf_path } },
+    ports: {
+        groups: {
+            'en': {
+                position: { name: 'bottom' },
+                attrs: joint.util.merge({}, portGroupAttrs, {
+                    wire: { x2: 0, y2: -(TRIBUF_HEIGHT - TRIBUF_CENTER_Y) },
+                    port: { magnet: 'passive' }
+                }),
+                z: -1
+            }
+        }
+    }
+}, {
+    initialize() {
+        const bits = this.get('bits');
+        // GateSVG's in/out groups auto-center at size.height/2; buf_path's
+        // artwork doesn't scale with size, so re-pin them to the triangle's
+        // fixed center instead of letting them drift down with the taller box.
+        const dy = TRIBUF_CENTER_Y - TRIBUF_HEIGHT / 2;
+        // 'bottom' auto-centers en at the box's own width/2 (30); buf_path's
+        // artwork isn't centered in the box (it spans x:18..52), so re-pin
+        // it to the triangle's true horizontal center instead.
+        const enDx = TRIBUF_CENTER_X - this.get('size').width / 2;
+        this.get('ports').items = [
+            { id: 'in', group: 'in', dir: 'in', bits: bits, args: { dy } },
+            { id: 'en', group: 'en', dir: 'in', bits: 1, args: { dx: enDx } },
+            { id: 'out', group: 'out', dir: 'out', bits: bits, args: { dy } }
+        ];
+
+        GateSVG.prototype.initialize.apply(this, arguments);
+
+        this.on('change:bits', (_, bits) => {
+            this._setPortsBits({ in: bits, out: bits });
+        });
+    },
+    operation(data) {
+        const bits = this.get('bits');
+        const en = data.en.get(0);
+        if (en === 1) return { out: data.in };
+        if (en === -1) return { out: Vector4vl.zes(bits) };
+        // en is x or z: per-bit ternary against a constant-z false branch
+        const out = [];
+        for (let i = 0; i < bits; i++)
+            out.push(data.in.get(i) === 2 ? 2 : 0);
+        return { out: Vector4vl.fromArray(out) };
+    }
+});
+export const TribufView = GateView;
