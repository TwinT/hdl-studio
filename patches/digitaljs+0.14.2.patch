new file mode 100644
index 0000000..c8201d5
--- /dev/null
+++ b/node_modules/digitaljs/src/cells/trimerge.mjs
@@ -0,0 +1,58 @@
+"use strict";
+
+import { Box, BoxView } from './base.mjs';
+import { Vector4vl } from '@twint/4vl';
+
+// Resolves N same-width drivers of one net into a single value: a real
+// (non-z) driver passes through, 2+ real drivers that agree pass that
+// value through, 2+ real drivers that disagree produce contention (x),
+// and all-z produces z. Synthesized purely during yosys2digitaljs's JSON
+// conversion for nets with more than one source; no yosys cell backs it.
+//
+// Rendered as a plain vertical bar - a bus-junction glyph where the inputs
+// converge on the left and a single output continues out the right, no
+// text label needed.
+export const TriMerge = Box.define('TriMerge', {
+    /* default properties */
+    inputs: 2,
+    bits: 1,
+    propagation: 0,
+
+    size: { width: 10, height: undefined }
+}, {
+    initialize() {
+        const bits = this.get('bits');
+        const inputs = this.get('inputs');
+
+        this.get('size').height = inputs * 16 + 8;
+
+        const ports = [];
+        for (let i = 0; i < inputs; i++)
+            ports.push({ id: 'in' + i, group: 'in', dir: 'in', bits: bits });
+        ports.push({ id: 'out', group: 'out', dir: 'out', bits: bits });
+        this.get('ports').items = ports;
+
+        Box.prototype.initialize.apply(this, arguments);
+    },
+    operation(data) {
+        const inputs = this.get('inputs');
+        let ret = data.in0;
+        for (let i = 1; i < inputs; i++)
+            ret = this._mergeTwo(ret, data['in' + i]);
+        return { out: ret };
+    },
+    _mergeTwo(a, b) {
+        const out = [];
+        for (let i = 0; i < a.bits; i++) {
+            const av = a.get(i), bv = b.get(i);
+            // 0 here means 'x' (contention), per Vector4vl.fromArray's encoding
+            out.push(av === 2 ? bv : bv === 2 ? av : av === bv ? av : 0);
+        }
+        return Vector4vl.fromArray(out);
+    },
+    _gateParams: Box.prototype._gateParams.concat(['inputs']),
+    _unsupportedPropChanges: Box.prototype._unsupportedPropChanges.concat(['inputs']),
+    _operationHelpers: Box.prototype._operationHelpers.concat(['_mergeTwo']),
+    _gateKind: 'bus'
+});
+export const TriMergeView = BoxView;
