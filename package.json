{
    "name": "hdl-studio",
    "displayName": "HDL Studio",
    "description": "Synthesize Verilog/SystemVerilog with Yosys and simulate the circuit on an interactive schematic, with waveforms and Lua scripting.",
    "version": "1.1.0",
    "license": "See LICENSE",
    "publisher": "TwinT",
    "repository": {
        "type": "git",
        "url": "https://github.com/TwinT/hdl-studio.git"
    },
    "engines": {
        "vscode": "^1.125.0"
    },
    "icon": "imgs/hdl-studio.png",
    "categories": [
        "Debuggers",
        "Education",
        "Programming Languages",
        "Visualization",
        "Other"
    ],
    "keywords": [
        "verilog",
        "systemverilog",
        "yosys",
        "simulation",
        "schematic",
        "waveform",
        "digital logic"
    ],
    "main": "./dist/local-extension.js",
    "contributes": {
        "commands": [
            {
                "command": "hdl-studio.openView",
                "title": "Open HDL Studio",
                "icon": { "light": "imgs/hdl-studio-light.svg", "dark": "imgs/hdl-studio-dark.svg" },
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.showPanel",
                "title": "Show HDL Studio Panel",
                "icon": { "light": "imgs/hdl-studio-light.svg", "dark": "imgs/hdl-studio-dark.svg" },
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.openViewJSON",
                "title": "Open as circuit in HDL Studio",
                "icon": { "light": "imgs/hdl-studio-light.svg", "dark": "imgs/hdl-studio-dark.svg" },
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.addToViewSource",
                "title": "Add to HDL Studio",
                "icon": { "light": "imgs/hdl-studio-light.svg", "dark": "imgs/hdl-studio-dark.svg" },
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.addToViewSourceRecursive",
                "title": "Add to HDL Studio (Recursive)",
                "icon": { "light": "imgs/hdl-studio-light.svg", "dark": "imgs/hdl-studio-dark.svg" },
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.newViewSource",
                "title": "Create circuit in HDL Studio",
                "icon": { "light": "imgs/hdl-studio-light.svg", "dark": "imgs/hdl-studio-dark.svg" },
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.newViewSourceRecursive",
                "title": "Create circuit in HDL Studio (Recursive)",
                "icon": { "light": "imgs/hdl-studio-light.svg", "dark": "imgs/hdl-studio-dark.svg" },
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.revealCircuit",
                "title": "Show active circuit",
                "icon": "$(output-view-icon)",
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.pause",
                "title": "Pause",
                "icon": "$(debug-pause)",
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.start",
                "title": "Start",
                "icon": "$(debug-start)",
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.newJSON",
                "title": "New Circuit",
                "icon": "$(new-file)",
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.addFiles",
                "title": "Add Files",
                "icon": "$(add)",
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.exportImage",
                "title": "Export Circuit As Image",
                "icon": "$(file-media)",
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.showLuaTerminal",
                "title": "Show Lua Terminal",
                "icon": "$(terminal)",
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.removeSource",
                "title": "Remove",
                "icon": "$(dash)",
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.stopScript",
                "title": "Stop script",
                "icon": "$(debug-stop)",
                "category": "HDL Studio"
            },
            {
                "command": "hdl-studio.startScript",
                "title": "Start script",
                "icon": "$(debug-start)",
                "category": "HDL Studio"
            }
        ],
        "customEditors": [
            {
                "viewType": "hdl-studio.circuitView",
                "displayName": "HDL Studio",
                "selector": [
                    {
                        "filenamePattern": "*.hdls"
                    },
                    {
                        "filenamePattern": "*.digitaljs"
                    }
                ],
                "priority": "default"
            },
            {
                "viewType": "hdl-studio.circuitView_json",
                "displayName": "HDL Studio",
                "selector": [
                    {
                        "filenamePattern": "*.json"
                    }
                ],
                "priority": "option"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "hdl-studio.openView",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.showPanel",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.openViewJSON",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.addToViewSource",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.addToViewSourceRecursive",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.newViewSource",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.newViewSourceRecursive",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.revealCircuit",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.pause",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.start",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.addFiles",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.exportImage",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.showLuaTerminal",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.removeSource",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.stopScript",
                    "when": "false"
                },
                {
                    "command": "hdl-studio.startScript",
                    "when": "false"
                }
            ],
            "view/title": [
                {
                    "command": "hdl-studio.newJSON",
                    "when": "view == hdl-studio-proj-files",
                    "group": "navigation@0"
                },
                {
                    "command": "hdl-studio.addFiles",
                    "when": "view == hdl-studio-proj-files",
                    "group": "navigation@1"
                },
                {
                    "command": "hdl-studio.exportImage",
                    "when": "view == hdl-studio-proj-files",
                    "group": "navigation@2"
                },
                {
                    "command": "hdl-studio.showLuaTerminal",
                    "when": "view == hdl-studio-proj-files",
                    "group": "navigation@3"
                }
            ],
            "editor/title": [
                {
                    "command": "hdl-studio.openView",
                    "when": "!hdl-studio.view_isfocus",
                    "group": "navigation"
                },
                {
                    "command": "hdl-studio.showPanel",
                    "when": "hdl-studio.view_isfocus",
                    "group": "navigation@0"
                },
                {
                    "command": "hdl-studio.pause",
                    "when": "hdl-studio.view_isfocus && hdl-studio.view_hascircuit && hdl-studio.view_running",
                    "group": "navigation@1"
                },
                {
                    "command": "hdl-studio.start",
                    "when": "hdl-studio.view_isfocus && hdl-studio.view_hascircuit && !hdl-studio.view_running",
                    "group": "navigation@1"
                }
            ],
            "explorer/context": [
                {
                    "command": "hdl-studio.openViewJSON",
                    "when": "resourceExtname == .json || resourceExtname == .hdls || resourceExtname == .digitaljs",
                    "group": "navigation@99999"
                },
                {
                    "command": "hdl-studio.addToViewSource",
                    "when": "hdl-studio.view_isactive && (resourceExtname =~ /^\\.sv$|^\\.v$|^\\.vh$|^\\.lua$|^\\.hex$|^\\.mem$/ || explorerResourceIsFolder)",
                    "group": "navigation@99999"
                },
                {
                    "command": "hdl-studio.addToViewSourceRecursive",
                    "when": "hdl-studio.view_isactive && explorerResourceIsFolder",
                    "group": "navigation@99999"
                },
                {
                    "command": "hdl-studio.newViewSource",
                    "when": "resourceExtname =~ /^\\.sv$|^\\.v$|^\\.vh$|^\\.lua$|^\\.hex$|^\\.mem$/ || explorerResourceIsFolder",
                    "group": "navigation@100000"
                },
                {
                    "command": "hdl-studio.newViewSourceRecursive",
                    "when": "explorerResourceIsFolder",
                    "group": "navigation@100000"
                }
            ],
            "view/item/context": [
                {
                    "command": "hdl-studio.removeSource",
                    "when": "view == hdl-studio-proj-files && viewItem != root-circuit",
                    "group": "inline"
                },
                {
                    "command": "hdl-studio.startScript",
                    "when": "view == hdl-studio-proj-files && viewItem in hdl-studio.script_not_running",
                    "group": "inline"
                },
                {
                    "command": "hdl-studio.stopScript",
                    "when": "view == hdl-studio-proj-files && viewItem in hdl-studio.script_running",
                    "group": "inline"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "hdl-studio-container",
                    "title": "HDL Studio",
                    "icon": "imgs/hdl-studio_mono.svg"
                }
            ]
        },
        "views": {
            "hdl-studio-container": [
                {
                    "id": "hdl-studio-proj-files",
                    "name": "Files",
                    "icon": "$(files)",
                    "contextualTitle": "HDL Studio Files"
                },
                {
                    "id": "hdl-studio-proj-synth",
                    "type": "webview",
                    "name": "Synthesis",
                    "icon": "$(gear)",
                    "contextualTitle": "HDL Studio Synthesis"
                },
                {
                    "id": "hdl-studio-proj-status",
                    "type": "webview",
                    "name": "Control",
                    "icon": "$(info)",
                    "contextualTitle": "HDL Studio Control"
                }
            ]
        },
        "configuration": {
            "title": "HDL Studio",
            "properties": {
                "hdl-studio.yosysPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the yosys executable. If empty, yosys from the PATH will be used."
                },
                "hdl-studio.waveform.colors": {
                    "type": "object",
                    "markdownDescription": "Colours of the waveform monitor, as CSS colours (any key can be left out). The default is [Surfer](https://surfer-project.org)'s dark theme.",
                    "default": {
                        "background": "#0b151d",
                        "altBackground": "#1b252d",
                        "foreground": "#d4d4d4",
                        "grid": "#222222",
                        "signal": "#56c126",
                        "undefined": "#f44747",
                        "highImpedance": "#c9e124",
                        "cursor": "#b63935",
                        "fillOpacity": 0.2
                    },
                    "properties": {
                        "background": {
                            "type": "string",
                            "description": "Background."
                        },
                        "altBackground": {
                            "type": "string",
                            "description": "Background of every other group of three rows."
                        },
                        "foreground": {
                            "type": "string",
                            "description": "Text and the ruler."
                        },
                        "grid": {
                            "type": "string",
                            "description": "Vertical grid lines."
                        },
                        "signal": {
                            "type": "string",
                            "description": "A defined signal (one colour for 0 and 1)."
                        },
                        "undefined": {
                            "type": "string",
                            "description": "An x value."
                        },
                        "highImpedance": {
                            "type": "string",
                            "description": "A z value."
                        },
                        "cursor": {
                            "type": "string",
                            "description": "Where a trigger paused the simulation."
                        },
                        "fillOpacity": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Opacity of the fill under a high (1) bit."
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "precompile": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "compile": "npm-run-all compile:*",
        "compile:rust": "cargo build --release",
        "compile:views": "webpack --mode production",
        "watch": "npm-run-all watch:*",
        "watch:webpack": "webpack --watch --mode development",
        "watch-prod": "npm-run-all watch-prod:*",
        "watch-prod:webpack": "webpack --watch --mode production",
        "lint": "eslint . && tsc",
        "pretest": "npm run lint",
        "test": "npm-run-all test:rust test:pipeline test:golden test:schematic test:vscode",
        "test:rust": "cargo test --workspace",
        "test:pipeline": "npm run compile:rust && mocha test/pipeline.spec.mjs",
        "test:golden": "npm run compile:rust && mocha test/golden.spec.mjs",
        "test:schematic": "npm run compile:rust && webpack --mode development --config-name schematic-view && mocha test/schematic.spec.mjs",
        "test:vscode": "node ./test/runTest.js"
    },
    "devDependencies": {
        "@playwright/browser-chromium": "^1.62.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "26.x",
        "@types/vscode": "^1.125.0",
        "@vscode/test-electron": "^3.0.0",
        "css-loader": "^7.1.4",
        "esbuild-loader": "^4.5.0",
        "eslint": "^10.5.0",
        "glob": "^13.0.6",
        "mocha": "^11.7.6",
        "npm-run-all": "^4.1.5",
        "playwright": "^1.62.1",
        "style-loader": "^4.0.0",
        "typescript": "^7.0.2",
        "webpack": "5.107.2",
        "webpack-cli": "^7.0.3"
    },
    "dependencies": {
        "@vscode/codicons": "^0.0.45",
        "base64-arraybuffer": "^1.0.2",
        "dequal": "^2.0.3",
        "elkjs": "^0.11.1",
        "luaparse": "^0.3.1"
    },
    "allowScripts": {
        "@parcel/watcher@2.5.6": true,
        "@vscode/vsce-sign@2.0.9": true,
        "keytar@7.9.0": true
    }
}
